# ============================================================
# EcoWatt Backend — Variables de entorno (Render)
# ============================================================
# Copia este archivo como .env para desarrollo local.
# NUNCA subas el .env real al repositorio.
# ============================================================


# ─────────────────────────────────────────
# BASE DE DATOS (Supabase / PostgreSQL)
# ─────────────────────────────────────────
# Host de la base de datos (En nuestro caso el de supabase)
DATABASE_HOST=db.xxxx.supabase.co

# Puerto de PostgreSQL (Supabase usa 5432 por defecto)
DATABASE_PORT=5432

# Nombre del usuario de la base de datos
DATABASE_USER=postgres

# Contraseña del usuario de la base de datos
DATABASE_PASSWORD=tu_password_supabase

# Nombre de la base de datos
DATABASE_NAME=postgres

# URL de conexión completa (alternativa a los campos individuales)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:tu_password@db.xxxx.supabase.co:5432/postgres


# ─────────────────────────────────────────
# API DE ESIOS (Red Eléctrica de España)
# ─────────────────────────────────────────
# Token de autenticación — solicitar en: consultasios@ree.es
ESIOS_TOKEN=tu_token_esios

# URL base de la API de ESIOS (no cambiar)
ESIOS_BASE_URL=https://api.esios.ree.es


# ─────────────────────────────────────────
# FIREBASE (Notificaciones Push)
# ─────────────────────────────────────────
# JSON completo de la clave de servicio de Firebase Admin SDK
# Obtenerlo en: Firebase Console → Configuración del proyecto → Cuentas de servicio
# Pegar el JSON en una sola línea (sin saltos de línea)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"..."}


# ─────────────────────────────────────────
# CORREO (Nodemailer — recuperación de contraseña)
# Proveedor: Brevo (antiguo Sendinblue)
# ─────────────────────────────────────────
# Host SMTP de Brevo (no cambiar)
MAIL_HOST=smtp-relay.brevo.com

# Puerto SMTP de Brevo (2525 — alternativa a 587, misma seguridad TLS/STARTTLS)
MAIL_PORT=2525

# Tu dirección de correo registrada en Brevo
MAIL_USER=tu_email@dominio.com

# Clave SMTP de Brevo (NO es tu contraseña de Brevo)
# Generarla en: Brevo → SMTP & API → Claves SMTP
MAIL_PASSWORD=tu_clave_smtp_brevo


# ─────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────
# Puerto del servidor (Render lo asigna automáticamente via PORT)
PORT=3000

# Clave secreta para firmar los tokens JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: debe estar definida en Render — sin esta variable el JWT no funciona
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_y_aleatoria